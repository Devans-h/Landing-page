# /etc/systemd/system/webinar.service
[Unit]
Description=Webinar landing site (webinar.tringtringai.com)
After=network.target postgresql.service

[Service]
Type=simple
User=webinar
WorkingDirectory=/var/www/webinar
EnvironmentFile=/var/www/webinar/.env
Environment=NODE_ENV=production
Environment=PORT=3000
ExecStart=/usr/bin/node server.js
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
